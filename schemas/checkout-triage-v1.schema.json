{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faber2026.jakobtfaber.com/schemas/checkout-triage-v1.schema.json",
  "title": "Faber2026 checkout advisory triage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "tool_version",
    "input_sha256",
    "inventory_identity",
    "advisory_records",
    "relationships",
    "conflicts",
    "unresolved_human_questions",
    "aggregate_counts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_uri": {
      "const": "https://faber2026.jakobtfaber.com/schemas/checkout-triage-v1.schema.json"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventory_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool_version",
        "scan_roots"
      ],
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "schema_uri": {
          "type": "string"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "scan_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "advisory_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/advisory_record"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "unresolved_human_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aggregate_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_checkouts",
        "classification_counts",
        "confidence_counts",
        "relationship_count",
        "conflict_count",
        "unresolved_question_count"
      ],
      "properties": {
        "total_checkouts": {
          "type": "integer",
          "minimum": 0
        },
        "classification_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active",
            "author-scratch",
            "candidate",
            "potentially-orphaned",
            "review-ready",
            "superseded",
            "unknown"
          ],
          "properties": {
            "active": {"type": "integer", "minimum": 0},
            "author-scratch": {"type": "integer", "minimum": 0},
            "candidate": {"type": "integer", "minimum": 0},
            "potentially-orphaned": {"type": "integer", "minimum": 0},
            "review-ready": {"type": "integer", "minimum": 0},
            "superseded": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0}
          }
        },
        "confidence_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high", "low", "medium"],
          "properties": {
            "high": {"type": "integer", "minimum": 0},
            "low": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0}
          }
        },
        "relationship_count": {
          "type": "integer",
          "minimum": 0
        },
        "conflict_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_question_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "advisory_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkout_id",
        "proposed_classification",
        "confidence",
        "evidence",
        "counterevidence",
        "missing_evidence",
        "conflicts",
        "human_questions"
      ],
      "properties": {
        "checkout_id": {
          "type": "string",
          "minLength": 1
        },
        "proposed_classification": {
          "enum": [
            "author-scratch",
            "active",
            "candidate",
            "review-ready",
            "superseded",
            "potentially-orphaned",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "counterevidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "checkout_ids",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "checkout_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "checkout_ids",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "checkout_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "detail"],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
