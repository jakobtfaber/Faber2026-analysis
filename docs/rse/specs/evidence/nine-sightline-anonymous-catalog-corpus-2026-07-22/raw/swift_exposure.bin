    <VALUES null="-2147483648"/>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.id" name="orig_obsid">
    <DESCRIPTION>Observation Number as Originally Assigned (Orig_Target_ID + Orig_Obs_Segment)</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.id;meta.main" name="obsid" ID="DataLinkID">
    <DESCRIPTION>Unique Observation Number (Target_ID + Obs_Segment)</DESCRIPTION>
   </FIELD>
   <FIELD unit="s" datatype="double" ucd="time.duration;obs.exposure;em.X-ray" precision="F5" name="xrt_exposure">
