<?xml version="1.0"?>
<VOTABLE xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xsi:noNamespaceSchemaLocation="http://www.ivoa.net/xml/VOTable/v1.3" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.4">
 <RESOURCE type="results">
  <INFO name="QUERY_STATUS" value="OK">No errors detected in query preprocessing</INFO>
  <TABLE>
   <DESCRIPTION>Query result for:&#xA;SELECT TOP 1 * FROM swiftmastr</DESCRIPTION>
   <FIELD datatype="char" arraysize="*" name="__row"/>
   <FIELD datatype="char" arraysize="*" ucd="meta.id;src" name="name">
    <DESCRIPTION>Designation of the Pointed Source</DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" ucd="meta.id;src" name="orig_target_id" width="8">
    <DESCRIPTION>Trigger Number as Originally Assigned</DESCRIPTION>
    <VALUES null="-2147483648"/>
   </FIELD>
   <FIELD datatype="int" ucd="meta.id;src" name="target_id" width="8">
    <DESCRIPTION>Unique Trigger Number with Any Degeneracy Removed</DESCRIPTION>
    <VALUES null="-2147483648"/>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.eq.ra;meta.main" precision="F5" name="ra">
    <DESCRIPTION>Right Ascension (Pointing Position)</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.eq.dec;meta.main" precision="F5" name="dec">
    <DESCRIPTION>Declination (Pointing Position)</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" precision="F5" name="roll_angle">
    <DESCRIPTION>Roll Angle (degree)</DESCRIPTION>
   </FIELD>
   <FIELD unit="d" datatype="double" ucd="time.start;obs" name="start_time">
    <DESCRIPTION>Start Time of the Observation</DESCRIPTION>
   </FIELD>
   <FIELD unit="d" datatype="double" ucd="time.end;obs" name="stop_time">
    <DESCRIPTION>Stop Time of the Observation</DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" ucd="meta.id" name="orig_obs_segment" width="3">
    <DESCRIPTION>Observation Segment as Originally Assigned</DESCRIPTION>
    <VALUES null="-2147483648"/>
   </FIELD>
   <FIELD datatype="int" ucd="meta.id" name="obs_segment" width="3">
